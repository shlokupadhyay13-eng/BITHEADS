# Government Policies & Reports Analyser - Frontend Environment Variables
# NOTE: Never store secrets, tokens, or private keys here. All frontend variables are public.

# Set to 'true' to use verified local mock data in development mode.
# Set to 'false' to connect to Person 3's real Express backend.
VITE_USE_MOCK_API=true

# Base URL for Express backend REST API
VITE_API_BASE_URL=http://localhost:5000/api
