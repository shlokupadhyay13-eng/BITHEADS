{
  "name": "gov-policy-analyser-backend",
  "version": "1.0.0",
  "description": "Database architecture, schemas, integration contracts and QA suite for Government Policies & Reports Analyser",
  "main": "server.js",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run tests/unit tests/integration",
    "test:jest": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
